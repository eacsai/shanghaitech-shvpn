+package atrust
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"sync/atomic"
+	"testing"
+)
+
+func TestGetBestNodesKeepsNodeAlignedWhenIPv6IsSkipped(t *testing.T) {
+	const group = "test-group"
+	const ipv6Node = "[2001:db8::1]:441"
+	const ipv4Node = "192.0.2.10:441"
+
+	var calls atomic.Int32
+	dialContext := func(_ context.Context, _ string, address string) (net.Conn, error) {
+		calls.Add(1)
+		if address != ipv4Node {
+			return nil, fmt.Errorf("unexpected probe address %q", address)
+		}
+
+		client, server := net.Pipe()
+		if err := server.Close(); err != nil {
+			return nil, err
+		}
+		return client, nil
+	}
+
+	bestNodes := getBestNodes(map[string][]string{
+		group: {ipv6Node, ipv4Node},
+	}, dialContext)
+
+	if got := bestNodes[group]; got != ipv4Node {
+		t.Fatalf("best node = %q, want %q", got, ipv4Node)
+	}
+	if got := calls.Load(); got != pingNum {
+		t.Fatalf("dial calls = %d, want %d", got, pingNum)
+	}
+}
+
+func TestGetBestNodesFallbackUsesFirstProbeableNode(t *testing.T) {
+	const group = "test-group"
+	const ipv6Node = "[2001:db8::1]:441"
+	const ipv4Node = "192.0.2.10:441"
+
+	var calls atomic.Int32
+	dialContext := func(_ context.Context, _ string, address string) (net.Conn, error) {
+		calls.Add(1)
+		if address != ipv4Node {
+			return nil, fmt.Errorf("unexpected probe address %q", address)
+		}
+		return nil, fmt.Errorf("simulated probe failure")
+	}
+
+	bestNodes := getBestNodes(map[string][]string{
+		group: {ipv6Node, ipv4Node},
+	}, dialContext)
+
+	if got := bestNodes[group]; got != ipv4Node {
+		t.Fatalf("fallback node = %q, want %q", got, ipv4Node)
+	}
+	if got := calls.Load(); got != pingNum {
+		t.Fatalf("dial calls = %d, want %d", got, pingNum)
+	}
+}
